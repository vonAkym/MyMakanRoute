PORT=3000
NODE_ENV=development
# Supabase > Connect > Session pooler connection string (IPv4-friendly)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Optional: require (encrypted) or disable. Default: disable for localhost, require otherwise.
# DATABASE_SSL=require
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase > Project Settings > API Keys > publishable (anon) key. Safe for Auth calls; NOT the secret key.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
HIDDEN_GEM_MIN_RATING=4.3
HIDDEN_GEM_MAX_REVIEWS=100
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
